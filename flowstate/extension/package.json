{
  "name": "flowstate",
  "displayName": "FlowState",
  "description": "Ground-truth context capture and restoration for interrupted work — fully local, fully offline.",
  "version": "0.1.0",
  "publisher": "random-state",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowstate.captureSnapshot",
        "title": "FlowState: Capture Snapshot Now"
      },
      {
        "command": "flowstate.rehydrateLatest",
        "title": "FlowState: Rehydrate Latest Session"
      }
    ],
    "keybindings": [
      {
        "command": "flowstate.captureSnapshot",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "FlowState",
      "properties": {
        "flowstate.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "URL of the local FlowState daemon. Must be a localhost address."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  }
}
